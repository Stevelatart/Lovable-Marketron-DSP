# Database — SQLite for local dev, swap to postgres:// for production
DATABASE_URL="file:./dev.db"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-secret"
NEXTAUTH_URL="http://localhost:3000"

# Gmail API (OAuth2) — for overnight report parsing
# Set these up at: https://console.cloud.google.com
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_USER_EMAIL="stevelatart@brandography.com"

# Cron job protection secret
CRON_SECRET="replace-with-cron-secret"

# Amazon DSP report sender (used to filter emails)
DSP_REPORT_FROM_FILTER="amazon.com"
DSP_REPORT_SUBJECT_FILTER="Amazon DSP"
